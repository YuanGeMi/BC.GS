# Copy this file to `.env` and fill in values from the Supabase dashboard.
# Prisma reads `.env` (not `.env.local`).

# --- Site (SEO: sitemap, hreflang, canonical) ---
NEXT_PUBLIC_SITE_URL=https://www.bc.gs

# --- Supabase API (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server only. Use quotes so special characters are not stripped.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-or-sb_secret-key"

# --- Database / Prisma (Project Settings → Database → Connection string) ---
# DATABASE_URL = Transaction pooler (port 6543) for runtime queries in serverless.
#   Copy the "Transaction pooler" URI, then append ?pgbouncer=true (or &pgbouncer=true if the URI already has query params).
# DIRECT_URL   = Direct connection (db.<ref>.supabase.co, port 5432) for migrations and prisma db push.
#   Copy the "Direct connection" URI — user is postgres (not postgres.<ref>).
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:[YOUR-PASSWORD]@aws-0-YOUR-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# --- Auth.js ---
AUTH_SECRET="generate-with-openssl-rand-base64-32"
