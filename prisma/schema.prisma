generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Casino {
  id              String              @id @default(cuid())
  slug            String              @unique
  logoUrl         String?
  establishedYear Int?
  minDeposit      Float?
  payoutSpeedId   String?
  payoutSpeed     PayoutSpeedOption?  @relation(fields: [payoutSpeedId], references: [id], onDelete: SetNull)
  paymentMethods  String[]
  gameProviders   String[]
  overallRating   Float?
  ratingBonuses   Float?
  ratingGames     Float?
  ratingSupport   Float?
  ratingPayout    Float?
  ratingTrust     Float?
  affiliateLink   String?
  status          String              @default("draft") // draft | published
  translations    CasinoTranslation[]
  bonuses         Bonus[]
  categories      CasinoCategory[]
  licenses        CasinoLicense[]
  markets         CasinoMarket[]
  affiliateClicks AffiliateClick[]
  userReviews     UserReview[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model License {
  id           String               @id @default(cuid())
  slug         String               @unique
  translations LicenseTranslation[]
  casinos      CasinoLicense[]
}

model LicenseTranslation {
  id        String  @id @default(cuid())
  licenseId String
  license   License @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  locale    String
  name      String

  @@unique([licenseId, locale])
}

model CasinoLicense {
  casinoId        String
  casino          Casino  @relation(fields: [casinoId], references: [id], onDelete: Cascade)
  licenseId       String
  license         License @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  licenseNumber   String?
  verified        Boolean @default(false)
  verificationUrl String?

  @@id([casinoId, licenseId])
}

model PayoutSpeedOption {
  id           String                         @id @default(cuid())
  slug         String                         @unique
  sortOrder    Int                            @default(0)
  translations PayoutSpeedOptionTranslation[]
  casinos      Casino[]
}

model PayoutSpeedOptionTranslation {
  id       String            @id @default(cuid())
  optionId String
  option   PayoutSpeedOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  locale   String
  label    String

  @@unique([optionId, locale])
}

model CasinoTranslation {
  id             String   @id @default(cuid())
  casinoId       String
  casino         Casino   @relation(fields: [casinoId], references: [id], onDelete: Cascade)
  locale         String // "en" | "zh" | "th"
  name           String
  reviewBody     String   @db.Text
  pros           String[]
  cons           String[]
  seoTitle       String?
  seoDescription String?

  @@unique([casinoId, locale])
}

model Bonus {
  id                  String             @id @default(cuid())
  casinoId            String
  casino              Casino             @relation(fields: [casinoId], references: [id], onDelete: Cascade)
  type                String // welcome | no-deposit | free-spins | reload | cashback
  amount              String?
  wageringRequirement String?
  minDeposit          Float?
  code                String?
  expiryDate          DateTime?
  status              String             @default("draft") // draft | published
  translations        BonusTranslation[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

model BonusTranslation {
  id      String @id @default(cuid())
  bonusId String
  bonus   Bonus  @relation(fields: [bonusId], references: [id], onDelete: Cascade)
  locale  String // "en" | "zh" | "th"
  title   String
  terms   String @db.Text

  @@unique([bonusId, locale])
}

model Category {
  id           String                @id @default(cuid())
  slug         String                @unique
  status       String                @default("draft") // draft | published
  translations CategoryTranslation[]
  casinos      CasinoCategory[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
}

model CategoryTranslation {
  id             String   @id @default(cuid())
  categoryId     String
  category       Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  locale         String // "en" | "zh" | "th"
  name           String
  description    String?  @db.Text
  seoTitle       String?
  seoDescription String?
  methodology    String?  @db.Text

  @@unique([categoryId, locale])
}

model CasinoCategory {
  casinoId   String
  casino     Casino               @relation(fields: [casinoId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category             @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  rank       Int?
  notes      CasinoCategoryNote[]

  @@id([casinoId, categoryId])
}

model CasinoCategoryNote {
  id             String         @id @default(cuid())
  casinoId       String
  categoryId     String
  casinoCategory CasinoCategory @relation(fields: [casinoId, categoryId], references: [casinoId, categoryId], onDelete: Cascade)
  locale         String
  editorialNote  String         @db.Text

  @@unique([casinoId, categoryId, locale])
}

model User {
  id           String       @id // auth.users.id
  email        String       @unique
  displayName  String?
  passwordHash String?
  role         String       @default("user")
  reviews      UserReview[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model UserReview {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  casinoId  String
  casino    Casino   @relation(fields: [casinoId], references: [id], onDelete: Cascade)
  rating    Int // 1-5
  body      String   @db.Text
  status    String   @default("pending") // "pending" | "published" | "rejected"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, casinoId])
}

model Market {
  id           String              @id @default(cuid())
  code         String              @unique // ISO 3166-1 alpha-2, e.g. "US", "TH", "GB"
  translations MarketTranslation[]
  casinos      CasinoMarket[]
}

model MarketTranslation {
  id       String @id @default(cuid())
  marketId String
  market   Market @relation(fields: [marketId], references: [id], onDelete: Cascade)
  locale   String
  name     String

  @@unique([marketId, locale])
}

model CasinoMarket {
  casinoId      String
  casino        Casino  @relation(fields: [casinoId], references: [id], onDelete: Cascade)
  marketId      String
  market        Market  @relation(fields: [marketId], references: [id], onDelete: Cascade)
  status        String  @default("available") // "available" | "restricted"
  affiliateLink String?

  @@id([casinoId, marketId])
}

model AffiliateClick {
  id        String   @id @default(cuid())
  casinoId  String
  casino    Casino   @relation(fields: [casinoId], references: [id], onDelete: Cascade)
  bonusId   String?
  locale    String
  referrer  String?
  createdAt DateTime @default(now())
}

model StaticPage {
  id           String                  @id @default(cuid())
  slug         String                  @unique // privacy | terms | responsible-gambling
  status       String                  @default("draft") // draft | published
  translations StaticPageTranslation[]
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
}

model StaticPageTranslation {
  id             String     @id @default(cuid())
  pageId         String
  page           StaticPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  locale         String // en | zh | th
  title          String
  content        String     @db.Text // Markdown
  seoTitle       String?
  seoDescription String?

  @@unique([pageId, locale])
}
